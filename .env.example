# Copy to .env (docker compose reads it automatically). All settings are
# prefixed JSP_ and documented in backend/app/config.py.

# REQUIRED in any real deployment: long random secret for session JWTs.
JSP_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# Providers. "local" = deterministic on-box providers; nothing leaves the
# deployment. DO NOT switch to an external provider (e.g. "anthropic") until
# the product owner confirms data-residency approval (brief §11/§14.2).
JSP_LLM_PROVIDER=local
JSP_EMBEDDING_PROVIDER=local
# JSP_ANTHROPIC_API_KEY=

# Ingestion source: fixture (bundled sample data) | api | crawl.
# API feed is the preferred real source — supply the endpoint + key:
JSP_SOURCE_ADAPTER=fixture
# JSP_API_FEED_URL=
# JSP_API_FEED_KEY=
# Crawler stays off until ToS is confirmed with the product owner (§14.1):
# JSP_CRAWL_ENABLED=false
