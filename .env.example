# Copy to .env (docker compose reads it automatically for substitution).
# All settings are prefixed JSP_ and documented in backend/app/config.py.
#
# The values shipped here are the SAFE demo defaults (fixture data, local
# providers, crawler off). The "real run" blocks below are commented out —
# uncomment and fill them in to crawl the live portal and use DeepSeek, per
# docs/CRAWL_AUTHORIZATION.md and docs/PROVIDER_DECISION.md.

# ── Secrets ──────────────────────────────────────────────────────────────
# REQUIRED in any real deployment: long random secret for session JWTs.
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JSP_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# ── LLM provider ─────────────────────────────────────────────────────────
# "local" = extractive on-box composer; nothing leaves the deployment.
# "deepseek" sends queries + retrieved passages to DeepSeek (overseas
# provider) — approved decision recorded in docs/PROVIDER_DECISION.md.
JSP_LLM_PROVIDER=local
# JSP_LLM_PROVIDER=deepseek
# JSP_DEEPSEEK_API_KEY=        <- supply separately; never commit
# JSP_DEEPSEEK_MODEL=deepseek-chat

# ── Embeddings (always on-box) ───────────────────────────────────────────
# "sentence_transformers" = real semantic embeddings, runs locally.
# JSP_EMBEDDING_DIM must match the model (all-MiniLM-L6-v2 = 384); the
# pgvector column dimension is created from it, so set BOTH before first
# ingest — or wipe the db volume / run `app.cli ingest --reembed` after
# changing them.
JSP_EMBEDDING_PROVIDER=local
# JSP_EMBEDDING_PROVIDER=sentence_transformers
# JSP_EMBEDDING_DIM=384
# JSP_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Defaults (0.18 / 0.40) are tuned for the hashing embedder. Starting points
# for MiniLM — validate against real queries after the first crawl:
# JSP_RETRIEVAL_MIN_SCORE=0.30
# JSP_CLUSTER_SIMILARITY_THRESHOLD=0.55

# ── Ingestion source: fixture | api | crawl ──────────────────────────────
# An official API feed is preferred over crawling if one exists:
JSP_SOURCE_ADAPTER=fixture
# JSP_API_FEED_URL=
# JSP_API_FEED_KEY=
#
# Crawling (authorized for public portal content — docs/CRAWL_AUTHORIZATION.md;
# complete its first-run checklist, then uncomment):
# JSP_SOURCE_ADAPTER=crawl
# JSP_CRAWL_ENABLED=true
# JSP_CRAWL_SITEMAP_URL=https://jobsandskills.skillsfuture.gov.sg/sitemap.xml
# JSP_CRAWL_SEED_URLS=https://jobsandskills.skillsfuture.gov.sg/
# JSP_CRAWL_ALLOWED_DOMAINS=jobsandskills.skillsfuture.gov.sg
# Keep the first crawl bounded to validate extraction, then raise/remove:
# JSP_CRAWL_MAX_PAGES=200

# ── Seed accounts (`app.cli seed`) ───────────────────────────────────────
# CHANGE the passwords before seeding an instance you'll actually use.
# JSP_ADMIN_EMAIL=admin@example.com
# JSP_ADMIN_PASSWORD=
# JSP_DEMO_EMAIL=demo@example.com
# JSP_DEMO_PASSWORD=
# Demo-chat replay at seed time costs LLM calls on a real provider:
# JSP_SEED_DEMO_CHATS=false
